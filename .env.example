# Copy this file to .env and replace the placeholders with your real keys.
# Never commit .env — it is listed in .gitignore.

# xAI (Grok) API key — required from Phase 1. Get one at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# OpenWeather API key — required from Phase 2. Get one at https://openweathermap.org/api
# Note: new OpenWeather keys can take up to 2 hours to activate.
OPENWEATHER_API_KEY=your_openweather_api_key_here
